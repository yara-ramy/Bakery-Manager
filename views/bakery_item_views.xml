<odoo>
    <record id="bakery_item_kanban_view" model="ir.ui.view">
        <field name="name">bakery.item.kanban</field>
        <field name="model">bakery.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image_1920"/>
                <field name="price"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-3 p-2">
                            <field name="image_1920"
                               widget="image"
                               class="rounded"
                               style="width: 100px; height: 100px; object-fit: cover;"/>
                            <div>
                                <h4>
                                    <field name="name"/>
                                </h4>
                                <div>
                                    <field name="currency_id" invisible="0"/>
                                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="bakery_item_form_view" model="ir.ui.view">
        <field name="name">bakery.item.form</field>
        <field name="model">bakery.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="d-flex justify-content-end mb-3">
                        <button name="action_add_to_cart" string="Add to cart"
                                type="object" class="btn-primary"/>
                    </div>
                    <field name="image_1920" widget="image"
                    style="width: 300px; height: 300px; object-fit: cover;"/>
                    <group>
                        <field name="name"/>
                        <field name="item_type" style="width: 250px;"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="price" widget="monetary"/>
                        <field name="is_available"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_all" model="ir.actions.act_window">
        <field name="name">All Items</field>
        <field name="res_model">bakery.item</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('is_available','=',True)]</field>
    </record>
    <record id="action_cakes" model="ir.actions.act_window">
        <field name="name">Cakes</field>
        <field name="res_model">bakery.item</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('item_type','=','cakes'),('is_available','=',True)]</field>
    </record>
    <record id="action_cookies" model="ir.actions.act_window">
        <field name="name">Cookies</field>
        <field name="res_model">bakery.item</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('item_type','=','cookies'),('is_available','=',True)]</field>
    </record>
    <record id="action_croissants" model="ir.actions.act_window">
        <field name="name">Croissants</field>
        <field name="res_model">bakery.item</field>
        <field name="view_mode">kanban,form</field>
        <field name="domain">[('item_type','=','croissants'),('is_available','=',True)]</field>
    </record>
</odoo>
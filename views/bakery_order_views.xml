<odoo>
    <record id="bakery_order_list_view" model="ir.ui.view">
        <field name="name">bakery.order.list</field>
        <field name="model">bakery.order</field>
        <field name="arch" type="xml">
            <list string="Your orders">
                <field name="customer_id"/>
                <field name="total_price"/>
            </list>
        </field>
    </record>
    <record id="bakery_order_form_view" model="ir.ui.view">
        <field name="name">bakery.order.form</field>
        <field name="model">bakery.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <sheet>
                    <div class="d-flex justify-content-end mb-3">
                        <button name="action_checkout"
                            string="Checkout"
                            type="object"
                            class="btn btn-primary"/>
                    </div>
                    <group>
                        <field name="customer_id"/>
                    </group>
                    <field name="order_line_ids">
                        <list editable="bottom">
                            <field name="item_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                    <field name="total_price"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
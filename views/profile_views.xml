<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bakery_profile_form_view" model="ir.ui.view">
        <field name="name">bakery.profile.form.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="My profile">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group string="Personal information">
                        <field name="phone"/>
                    </group>
                    <group string="Shipping address">
                        <field name="country_id"/>
                        <field name="city"/>
                        <field name="street"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_profile" model="ir.actions.server">
        <field name="name">My profile</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'name': 'My profile',
                'res_model': 'res.partner',
                'res_id': env.user.partner_id.id,
                'view_mode': 'form',
                'view_id': env.ref('my_bakery.bakery_profile_form_view').id,
                'target': 'current',
            }
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="track_order_list" model="ir.ui.view">
        <field name="name">track.order.list</field>
        <field name="model">bakery.order</field>
        <field name="arch" type="xml">
            <list string="Your orders">
                <field name="name"/>
                <field name="order_date"/>
                <field name="total_price"/>
            </list>
        </field>
    </record>
    <record id="track_order_form" model="ir.ui.view">
        <field name="name">track.order.form</field>
        <field name="model">bakery.order</field>
        <field name="arch" type="xml">
            <form string="Order details">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="customer_id" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="time_remaining_display" readonly="1"/>
                    </group>
                    <field name="order_line_ids" readonly="1">
                        <list>
                            <field name="item_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                    <group>
                        <field name="total_price" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_track_order" model="ir.actions.act_window">
        <field name="name">Track your order</field>
        <field name="res_model">bakery.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','in',['confirmed','shipped','in_transit'])]</field>
    </record>
    <record id="action_track_order_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="track_order_list"/>
        <field name="act_window_id" ref="action_track_order"/>
    </record>
    <record id="action_track_order_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="track_order_form"/>
        <field name="act_window_id" ref="action_track_order"/>
    </record>
</odoo>
<odoo>
    <record id="orders_list_view" model="ir.ui.view">
        <field name="name">bakery.orders.list</field>
        <field name="model">bakery.order</field>
        <field name="arch" type="xml">
            <list string="Your orders">
                <field name="name"/>
                <field name="order_date"/>
                <field name="total_price"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="orders_form_view" model="ir.ui.view">
        <field name="name">bakery.orders.form</field>
        <field name="model">bakery.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="cart,confirmed,shipped,in_transit,delivered"
                           readonly="1"/>
                </header>
                <sheet>
                    <div class="d-flex justify-content-end mb-3">
                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                class="btn btn-secondary"
                                invisible="status not in ['confirmed','cart']"/>
                    </div>
                    <div class="d-flex justify-content-end mb-3">
                        <button name="action_track"
                                string="Track your order"
                                type="object"
                                class="btn btn-primary"
                                invisible="status == 'delivered'"/>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="customer_id"/>
                    </group>
                    <field name="order_line_ids" readonly="1">
                        <list>
                            <field name="item_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                    <field name="total_price"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">bakery.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','!=','cart')]</field>
    </record>
    <record id="action_orders_list_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="orders_list_view"/>
        <field name="act_window_id" ref="action_orders"/>
    </record>
    <record id="action_orders_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="orders_form_view"/>
        <field name="act_window_id" ref="action_orders"/>
    </record>
</odoo>
<odoo>
    <record id="bakery_cart_wizard_view_form" model="ir.ui.view">
        <field name="name">bakery.cart.wizard.form</field>
        <field name="model">bakery.cart.wizard</field>
        <field name="arch" type="xml">
            <form string="Add to cart">
                <group>
                    <field name="item_id" readonly="1"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Add"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>